---
import SupportLink from './SupportLink.astro';
import UiIcon from './UiIcon.astro';
import '../styles/visitor-assistant.css';
---
<details class="visitor-assistant">
  <summary>
    <svg class="assistant-avatar" width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true">
      <path d="M17 6v4m1-5h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <rect x="6" y="10" width="24" height="18" rx="7" fill="#fff" />
      <circle cx="13.5" cy="18" r="1.5" fill="#10457e" />
      <circle cx="22.5" cy="18" r="1.5" fill="#10457e" />
      <path d="M15 22c1.4 1.4 4.6 1.4 6 0" stroke="#10457e" stroke-width="1.3" stroke-linecap="round" />
      <path d="m11 27-1 4 6-4" fill="#fff" />
    </svg>
    <span>Ask Incash</span>
  </summary>
  <div class="assistant-panel" aria-labelledby="assistant-title">
    <header>
      <h2 id="assistant-title">How can we help?</h2>
      <button type="button" class="assistant-close" aria-label="Close Ask Incash" hidden><UiIcon name="close" /></button>
    </header>
    <p>Chat is coming soon. In the meantime, find answers here or talk to our team.</p>
    <ul>
      <li><a href="/salary-advance-in-nigeria.html">Requesting a salary advance <UiIcon name="arrow" size={15} /></a></li>
      <li><a href="/earned-wage-access-in-nigeria.html">How earned wage access works <UiIcon name="arrow" size={15} /></a></li>
      <li><a href="/Employer.html">Offering Incash at work <UiIcon name="arrow" size={15} /></a></li>
    </ul>
    <SupportLink />
  </div>
</details>
<script>
  const assistant = document.querySelector<HTMLDetailsElement>('.visitor-assistant');
  const close = assistant?.querySelector<HTMLButtonElement>('.assistant-close');
  const trigger = assistant?.querySelector('summary');

  if (assistant && close && trigger) {
    const dismiss = () => {
      assistant.open = false;
      trigger.focus();
    };

    close.hidden = false;
    close.addEventListener('click', dismiss);
    assistant.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && assistant.open) {
        event.preventDefault();
        dismiss();
      }
    });
    assistant.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('a[href^="/"]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      assistant.open = false;
      if (link.pathname === location.pathname && link.hash) {
        document.getElementById(link.hash.slice(1))?.focus({ preventScroll: true });
      }
    });
  }
</script>

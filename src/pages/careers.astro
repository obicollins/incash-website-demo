---
import Base from '../layouts/Base.astro';
import BrandMotif from '../components/BrandMotif.astro';
---
<Base title="Careers at Incash Africa | Work With Us"
  description="Get in touch with the Incash careers team in Nigeria to express interest in working on employee financial wellness and workplace fintech."
  canonical="https://incash.africa/careers.html">
  <section class="hero inner-product has-brand-art">
    <BrandMotif variant="pair" />
    <div class="container">
      <h1>Careers at Incash</h1>
      <p class="lead">Help us make it easier for people to access their pay and for companies to manage payroll. Tell us about your experience and the work you’d like to do.</p>
      <div class="actions"><a class="button" href="mailto:careers@incash.africa">Email our careers team</a></div>
    </div>
  </section>
</Base>

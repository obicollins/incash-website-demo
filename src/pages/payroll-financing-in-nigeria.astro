  { question: 'How does payroll financing differ from earned wage access?', answer: 'Payroll financing funds an employer’s salary run. Earned wage access lets eligible employees request part of the pay they have already earned before payday.', link: {href: '/earned-wage-access-in-nigeria.html', label: 'Explore earned wage access'} },
  { question: 'Can I enquire about stock or supplier payments as well?', answer: 'For inventory, supplier invoices and other operating costs, ask about working capital financing.', link: {href: '/working-capital-in-nigeria.html', label: 'Explore working capital financing'} },
];
